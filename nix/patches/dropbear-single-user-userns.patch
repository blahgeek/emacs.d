diff --git a/tmp/dbtest/localoptions-export.h b/localoptions.h
new file mode 100644
index 00000000..a7f8ee24
--- /dev/null
+++ b/localoptions.h
@@ -0,0 +1,13 @@
+#pragma once
+
+/* Single-user system (e.g. unprivileged userns container where only one
+ * uid is mapped and setgroups(2) is denied): never setuid/setgid to
+ * another user. checkusername() restricts logins to the server's own uid,
+ * and svr_switch_user() skips setgid/initgroups/setuid. */
+#define DROPBEAR_SVR_MULTIUSER 0
+/* Avoid the seteuid/setegid paths in svr-agentfwd.c that are
+ * compiled in when DROPBEAR_SVR_DROP_PRIVS defaults to 0. */
+#define DROPBEAR_SVR_AGENTFWD 0
+/* Deliberately run the non-multiuser build on a multiuser kernel.
+ * Safe here because checkusername() only permits the server's own uid. */
+#define DROPBEAR_NONMULTIUSER_SKIP_KERNEL_CHECK 1
